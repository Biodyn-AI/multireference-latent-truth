\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Calibration metrics under matched Family-HB hyperparameters, decomposed into base-rate and denominator-invariant signal components. Raw precision is far higher in the context universe, but so is the reference base rate; the enrichment over random ($\mathrm  {Enr}@k=\mathrm  {P}@k/\text  {base}$, \Cref  {eq:enrichment}) shows the genuine ranking signal is modest in both. The raw P@5000 ratio ($30.7\times $) factors as base-rate ratio ($25.8\times $) $\times $ signal ratio ($1.4\times $).}}{9}{table.caption.13}\protected@file@percent }
\newlabel{tab:calibration}{{2}{9}{\rev {Calibration metrics under matched Family-HB hyperparameters, decomposed into base-rate and denominator-invariant signal components. Raw precision is far higher in the context universe, but so is the reference base rate; the enrichment over random ($\mathrm {Enr}@k=\mathrm {P}@k/\text {base}$, \Cref {eq:enrichment}) shows the genuine ranking signal is modest in both. The raw P@5000 ratio ($30.7\times $) factors as base-rate ratio ($25.8\times $) $\times $ signal ratio ($1.4\times $).}}{table.caption.13}{}}
\newlabel{tab:calibration@cref}{{[table][2][]2}{[1][8][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Universe-aware view of the apparent calibration uplift. (a) Denominator-invariant enrichment over random as a function of rank depth in each universe: the genuine signal is weak (near or below $1\times $ over most of the ranking) and concentrated in coarse posterior-tie blocks. (b) Decomposition of the raw context/full precision@5000 ratio into a base-rate (denominator) factor of $25.8\times $ and a genuine-signal factor of $\approx 1.4\times $.}}{9}{figure.caption.14}\protected@file@percent }
\newlabel{fig:univ}{{3}{9}{Universe-aware view of the apparent calibration uplift. (a) Denominator-invariant enrichment over random as a function of rank depth in each universe: the genuine signal is weak (near or below $1\times $ over most of the ranking) and concentrated in coarse posterior-tie blocks. (b) Decomposition of the raw context/full precision@5000 ratio into a base-rate (denominator) factor of $25.8\times $ and a genuine-signal factor of $\approx 1.4\times $}{figure.caption.14}{}}
\newlabel{fig:univ@cref}{{[figure][3][]3}{[1][8][]9}}
